# =============================================================================
# Local docker settings. Copy to `.env` (git-ignored) and edit as needed:
#     cp docker/.env.example docker/.env
# =============================================================================

# Match the container user to your host user so bind-mounted files stay
# writable. Generate with: echo "USER_UID=$(id -u)"; echo "USER_GID=$(id -g)"
USER_UID=1000
USER_GID=1000

# --- Which packaged environment under envs/ to launch --------------------
SIM_ENV_NAME=Blocks

# --- Rendering -----------------------------------------------------------
#   offscreen : GPU rendering with no window (cameras work)  <- default
#   nullrhi   : no rendering at all; fastest, but camera sensors return nothing
#   windowed  : on-screen window (needs X11 passthrough)
SIM_RENDER_MODE=offscreen
SIM_RES_X=1280
SIM_RES_Y=720

# Extra Unreal switches, e.g. "-NoVSync -benchmark"
SIM_EXTRA_ARGS=

# --- Networking ----------------------------------------------------------
# Where the sim's API ports are published on the host. 127.0.0.1 keeps them
# local; set to 0.0.0.0 to reach the sim from another machine.
SIM_BIND_ADDR=127.0.0.1

# --- Client image base ---------------------------------------------------
# Swap in a CUDA base if you need the `autonomy` extras (torch, onnxruntime-gpu):
#   CLIENT_BASE_IMAGE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
CLIENT_BASE_IMAGE=ubuntu:22.04
