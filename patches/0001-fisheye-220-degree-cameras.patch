@@ -25,6 +25,7 @@
 #include "RenderingThread.h"
 #include "Runtime/Engine/Classes/Kismet/KismetMathLibrary.h"
 #include "UObject/ConstructorHelpers.h"
+#include "FisheyeRemapCS.h"
