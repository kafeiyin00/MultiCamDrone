index 0000000..5c5456d
--- /dev/null
+++ b/unreal/Blocks/Plugins/ProjectAirSim/Source/ProjectAirSim/Private/Sensors/FisheyeRemapCS.cpp
@@ -0,0 +1,66 @@
+// Copyright (C) 2026 MultiCamDrone contributors
+//
+// MIT License. All rights reserved.
+
+#include "FisheyeRemapCS.h"
+
+#include "GlobalShader.h"
+#include "RenderGraphUtils.h"
+#include "ShaderParameterUtils.h"
+
+IMPLEMENT_GLOBAL_SHADER(FFisheyeRemapCS, "/CustomShaders/FisheyeRemapCS.usf",
+                        "MainComputeShader", SF_Compute);
+
+void DispatchFisheyeRemap(FRHICommandListImmediate& RHICmdList,
+                          const FFisheyeRemapArgs& Args) {
+  check(IsInRenderingThread());
+
+  if (!Args.OutputUAV.IsValid() || Args.OutputSize.X <= 0 ||
+      Args.OutputSize.Y <= 0 || Args.FocalPx <= 0.0f) {
+    return;
+  }
+
+  // A missing face would sample garbage, so refuse the whole frame rather than
+  // emit an image with a wedge of noise in it.
+  for (int32 i = 0; i < kFisheyeFaceCount; ++i) {
+    if (!Args.Faces[i].Texture.IsValid()) return;
+  }
+
+  TShaderMapRef<FFisheyeRemapCS> Shader(
+      GetGlobalShaderMap(GMaxRHIFeatureLevel));
+  if (!Shader.IsValid()) return;
+
+  FFisheyeRemapCS::FParameters Parameters;
+  Parameters.Face0 = Args.Faces[0].Texture;
+  Parameters.Face1 = Args.Faces[1].Texture;
+  Parameters.Face2 = Args.Faces[2].Texture;
+  Parameters.Face3 = Args.Faces[3].Texture;
+  Parameters.Face4 = Args.Faces[4].Texture;
+
+  // Bilinear so the seams between faces do not alias, clamped so a sample that
+  // lands a hair outside a face reuses its edge instead of wrapping to the
+  // opposite side of that face.
+  Parameters.FaceSampler =
+      TStaticSamplerState<SF_Bilinear, AM_Clamp, AM_Clamp, AM_Clamp>::GetRHI();
+
+  for (int32 i = 0; i < kFisheyeFaceCount; ++i) {
+    Parameters.FaceForward[i] = FVector4f(Args.Faces[i].Forward, 0.0f);
+    Parameters.FaceRight[i] = FVector4f(Args.Faces[i].Right, 0.0f);
+    Parameters.FaceDown[i] = FVector4f(Args.Faces[i].Down, 0.0f);
+  }
+
+  Parameters.OutputCentre =
+      FVector2f(Args.OutputSize.X * 0.5f, Args.OutputSize.Y * 0.5f);
+  Parameters.FocalPx = Args.FocalPx;
+  Parameters.ThetaMax = Args.ThetaMax;
+  Parameters.RadialModel = Args.RadialModel;
+  Parameters.OutputSize =
+      FUintVector2(static_cast<uint32>(Args.OutputSize.X),
+                   static_cast<uint32>(Args.OutputSize.Y));
+  Parameters.OutFisheye = Args.OutputUAV;
+
+  const FIntVector GroupCount = FComputeShaderUtils::GetGroupCount(
+      Args.OutputSize, FIntPoint(FISHEYE_THREADS_X, FISHEYE_THREADS_Y));
+
+  FComputeShaderUtils::Dispatch(RHICmdList, Shader, Parameters, GroupCount);
+}
diff --git a/unreal/Blocks/Plugins/ProjectAirSim/Source/ProjectAirSim/Private/Sensors/FisheyeRemapCS.h b/unreal/Blocks/Plugins/ProjectAirSim/Source/ProjectAirSim/Private/Sensors/FisheyeRemapCS.h
new file mode 100644
index 0000000..203947a
--- /dev/null
+++ b/unreal/Blocks/Plugins/ProjectAirSim/Source/ProjectAirSim/Private/Sensors/FisheyeRemapCS.h
@@ -0,0 +1,91 @@
+// Copyright (C) 2026 MultiCamDrone contributors
+//
+// MIT License. All rights reserved.
+//
+// Compute shader that assembles one fisheye image from five 90-degree
+// perspective faces. See Shaders/FisheyeRemapCS.usf for the mapping itself and
+// docs/FISHEYE.md for why it is done this way rather than with
+// USceneCaptureComponentCube.
+#pragma once
+
+#include "CoreMinimal.h"
+#if ENGINE_MAJOR_VERSION == 5
+  #if ENGINE_MINOR_VERSION >= 2
+    #include "DataDrivenShaderPlatformInfo.h"
+  #endif
+#endif
+#include "GlobalShader.h"
+#include "RHI.h"
+#include "ShaderParameterStruct.h"
+
+#define FISHEYE_THREADS_X 8
+#define FISHEYE_THREADS_Y 8
+#define FISHEYE_THREADS_Z 1
+
+// Centre, right, left, up, down. The sixth cube face is never sampled for any
+// field of view below 270 degrees, so it is never rendered either.
+static constexpr int32 kFisheyeFaceCount = 5;
+
+class FFisheyeRemapCS : public FGlobalShader {
+ public:
+  DECLARE_GLOBAL_SHADER(FFisheyeRemapCS);
+  SHADER_USE_PARAMETER_STRUCT(FFisheyeRemapCS, FGlobalShader);
+
+  BEGIN_SHADER_PARAMETER_STRUCT(FParameters, )
+  SHADER_PARAMETER_TEXTURE(Texture2D<float4>, Face0)
+  SHADER_PARAMETER_TEXTURE(Texture2D<float4>, Face1)
+  SHADER_PARAMETER_TEXTURE(Texture2D<float4>, Face2)
+  SHADER_PARAMETER_TEXTURE(Texture2D<float4>, Face3)
+  SHADER_PARAMETER_TEXTURE(Texture2D<float4>, Face4)
+  SHADER_PARAMETER_SAMPLER(SamplerState, FaceSampler)
+  // Orthonormal basis per face, already converted out of Unreal's axis
+  // convention into the shader's camera frame (x right, y down, z forward).
+  // Shader parameter arrays are float4-aligned, hence FVector4f.
+  SHADER_PARAMETER_ARRAY(FVector4f, FaceForward, [kFisheyeFaceCount])
+  SHADER_PARAMETER_ARRAY(FVector4f, FaceRight, [kFisheyeFaceCount])
+  SHADER_PARAMETER_ARRAY(FVector4f, FaceDown, [kFisheyeFaceCount])
+  SHADER_PARAMETER(FVector2f, OutputCentre)
+  SHADER_PARAMETER(float, FocalPx)
+  SHADER_PARAMETER(float, ThetaMax)
+  SHADER_PARAMETER(uint32, RadialModel)
+  SHADER_PARAMETER(FUintVector2, OutputSize)
+  SHADER_PARAMETER_UAV(RWTexture2D<float4>, OutFisheye)
+  END_SHADER_PARAMETER_STRUCT()
+
+  static bool ShouldCompilePermutation(
+      const FGlobalShaderPermutationParameters& Parameters) {
+    return IsFeatureLevelSupported(Parameters.Platform, ERHIFeatureLevel::SM5);
+  }
+
+  static inline void ModifyCompilationEnvironment(
+      const FGlobalShaderPermutationParameters& Parameters,
+      FShaderCompilerEnvironment& OutEnvironment) {
+    FGlobalShader::ModifyCompilationEnvironment(Parameters, OutEnvironment);
+    OutEnvironment.SetDefine(TEXT("THREADGROUPSIZE_X"), FISHEYE_THREADS_X);
+    OutEnvironment.SetDefine(TEXT("THREADGROUPSIZE_Y"), FISHEYE_THREADS_Y);
+    OutEnvironment.SetDefine(TEXT("THREADGROUPSIZE_Z"), FISHEYE_THREADS_Z);
+  }
+};
+
+// One rendered face and where it points.
+struct FFisheyeFace {
+  FVector3f Forward = FVector3f::ZeroVector;
+  FVector3f Right = FVector3f::ZeroVector;
+  FVector3f Down = FVector3f::ZeroVector;
+  FTextureRHIRef Texture;
+};
+
+struct FFisheyeRemapArgs {
+  FFisheyeFace Faces[kFisheyeFaceCount];
+  FUnorderedAccessViewRHIRef OutputUAV;
+  FIntPoint OutputSize = FIntPoint::ZeroValue;
+  // Pixels per radian for the equidistant model; see camera.cpp for how the
+  // other two laws scale it. Must match what camera_info publishes.
+  float FocalPx = 0.0f;
+  float ThetaMax = 0.0f;  // radians, half the fisheye field of view
+  uint32 RadialModel = 0;  // 0 equidistant, 1 equisolid, 2 stereographic
+};
+
+// Enqueues the remap. Must be called on the render thread.
+void DispatchFisheyeRemap(FRHICommandListImmediate& RHICmdList,
+                          const FFisheyeRemapArgs& Args);
