   UpdateCameraSettings();
 }
 
+// The five faces, as relative rotations of the camera component. Unreal's
+// component axes are X forward, Y right, Z up, so a +90 yaw points the face
+// along +Y and a +90 pitch points it along +Z. Five faces at 90 degrees cover
+// +/-135 degrees along each axis, which contains the +/-110 that a 220-degree
+// fisheye needs; the sixth (rear) face is never sampled, so it is never made.
+static const FRotator kFisheyeFaceRotations[kFisheyeFaceCount] = {
+    FRotator(0.0f, 0.0f, 0.0f),     // 0 centre
+    FRotator(0.0f, 90.0f, 0.0f),    // 1 right
+    FRotator(0.0f, -90.0f, 0.0f),   // 2 left
+    FRotator(90.0f, 0.0f, 0.0f),    // 3 up
+    FRotator(-90.0f, 0.0f, 0.0f),   // 4 down
+};
+
+// Unreal component frame (X forward, Y right, Z up) into the shader's camera
+// frame (x right, y down, z forward).
+static FVector3f UnrealAxisToCameraFrame(const FVector& V) {
+  return FVector3f(static_cast<float>(V.Y), static_cast<float>(-V.Z),
+                   static_cast<float>(V.X));
+}
+
+void UUnrealCamera::SetupFisheyeRig(
+    const projectairsim::CaptureSettings& CaptureSetting) {
+  if (!CaptureSetting.fisheye_enabled || bFisheyeRigBuilt) return;
+
+  const int32 FaceRes = FMath::Max(64, CaptureSetting.fisheye_face_resolution);
+  const int32 OutW = FMath::Max(1, CaptureSetting.width);
+  const int32 OutH = FMath::Max(1, CaptureSetting.height);
+
+  // The radial law and its focal length must match core_sim's camera_info
+  // exactly, or the published intrinsics will not describe the rendered image.
+  // f is fixed by putting the image circle radius at width/2 when theta is
+  // half the field of view.
+  const float ThetaMax = FMath::DegreesToRadians(CaptureSetting.fov_degrees) / 2.0f;
+  const float Radius = OutW / 2.0f;
+  float Focal;
+  switch (CaptureSetting.fisheye_model) {
+    case 1:  // equisolid, r = 2f*sin(theta/2)
+      Focal = Radius / (2.0f * FMath::Sin(ThetaMax / 2.0f));
+      break;
+    case 2:  // stereographic, r = 2f*tan(theta/2)
+      Focal = Radius / (2.0f * FMath::Tan(ThetaMax / 2.0f));
+      break;
+    default:  // equidistant, r = f*theta
+      Focal = Radius / ThetaMax;
+      break;
+  }
+
+  FisheyeThetaMax = ThetaMax;
+  FisheyeFocalPx = Focal;
+  FisheyeRadialModel = static_cast<uint32>(CaptureSetting.fisheye_model);
+
+  // Reuse the scene render target as the composite, so the readback in
+  // OnRendered() finds it through Capture->TextureTarget with no change. It
+  // needs a UAV for the compute shader to write into, and bCanCreateUAV only
+  // takes effect on (re-)initialisation.
+  const int32 SceneIdx =
+      projectairsim::MathUtils::ToNumeric(projectairsim::ImageType::kScene);
+  FisheyeComposite = RenderTargets[SceneIdx];
+  if (FisheyeComposite == nullptr) return;
+  FisheyeComposite->bCanCreateUAV = true;
+  FisheyeComposite->ClearColor = FLinearColor::Black;
+  FisheyeComposite->InitCustomFormat(OutW, OutH, EPixelFormat::PF_B8G8R8A8,
+                                     true);
+  if (!std::isnan(CaptureSetting.target_gamma))
+    FisheyeComposite->TargetGamma = CaptureSetting.target_gamma;
+  FisheyeComposite->UpdateResourceImmediate(true);
+
+  FisheyeFaceCaptures.Empty(kFisheyeFaceCount);
+  FisheyeFaceTargets.Empty(kFisheyeFaceCount);
+
+  for (int32 i = 0; i < kFisheyeFaceCount; ++i) {
+    UTextureRenderTarget2D* FaceTarget = NewObject<UTextureRenderTarget2D>(this);
+    FaceTarget->ClearColor = FLinearColor::Black;
+    FaceTarget->InitCustomFormat(FaceRes, FaceRes, EPixelFormat::PF_B8G8R8A8,
+                                 true);
+    if (!std::isnan(CaptureSetting.target_gamma))
+      FaceTarget->TargetGamma = CaptureSetting.target_gamma;
+    FaceTarget->UpdateResourceImmediate(true);
+
+    USceneCaptureComponent2D* FaceCapture = NewObject<USceneCaptureComponent2D>(
+        this, *FString::Printf(TEXT("FisheyeFace%d"), i));
+    FaceCapture->SetupAttachment(this);
+    FaceCapture->CaptureSource = ESceneCaptureSource::SCS_FinalColorLDR;
+    FaceCapture->bAutoActivate = false;
+    FaceCapture->bCaptureEveryFrame = false;
+    FaceCapture->bCaptureOnMovement = false;
+    // Required for post-process blendables to apply to a manual capture with
+    // bCaptureEveryFrame off -- same reason the stock captures set it.
+    FaceCapture->bAlwaysPersistRenderingState = true;
+    FaceCapture->ProjectionType = ECameraProjectionMode::Perspective;
+    // Exactly 90 degrees: the remap's gnomonic step assumes tan(45) = 1.
+    FaceCapture->FOVAngle = 90.0f;
+    FaceCapture->TextureTarget = FaceTarget;
+    FaceCapture->RegisterComponent();
+    FaceCapture->SetRelativeRotation(kFisheyeFaceRotations[i]);
+    if (!CaptureSetting.show_debug_plots)
+      HideDebugDrawComponent(FaceCapture, GetWorld());
+    UpdateCameraPostProcessingSetting(FaceCapture->PostProcessSettings,
+                                      CaptureSetting);
+    FaceCapture->Activate();
+
+    FisheyeFaceCaptures.Add(FaceCapture);
+    FisheyeFaceTargets.Add(FaceTarget);
+  }
+
+  bFisheyeEnabled = true;
+  bFisheyeRigBuilt = true;
+
+  UnrealLogger::Log(
+      projectairsim::LogLevel::kInfo,
+      TEXT("[UnrealCamera] Fisheye rig: %d faces at %dx%d -> %dx%d, "
+           "fov %.1f deg, model %d, f %.2f px/rad"),
+      kFisheyeFaceCount, FaceRes, FaceRes, OutW, OutH,
+      CaptureSetting.fov_degrees, CaptureSetting.fisheye_model, Focal);
+}
+
+void UUnrealCamera::CaptureFisheyeFaces() {
+  for (USceneCaptureComponent2D* FaceCapture : FisheyeFaceCaptures) {
+    if (FaceCapture != nullptr) FaceCapture->CaptureSceneDeferred();
+  }
+}
+
+void UUnrealCamera::RemapFisheye(FRHICommandListImmediate& RHICmdList) {
+  if (!bFisheyeRigBuilt || FisheyeComposite == nullptr) return;
+
+  FTextureRenderTargetResource* OutResource =
+      FisheyeComposite->GetRenderTargetResource();
+  if (OutResource == nullptr) return;
+
+  FFisheyeRemapArgs Args;
+  Args.OutputUAV = OutResource->GetUnorderedAccessViewRHI();
+  Args.OutputSize = FIntPoint(FisheyeComposite->SizeX, FisheyeComposite->SizeY);
+  Args.FocalPx = FisheyeFocalPx;
+  Args.ThetaMax = FisheyeThetaMax;
+  Args.RadialModel = FisheyeRadialModel;
+
+  if (!Args.OutputUAV.IsValid()) {
+    // bCanCreateUAV did not take, so the composite cannot be written. Say so
+    // once rather than silently publishing whatever the target last held.
+    static bool bWarned = false;
+    if (!bWarned) {
+      bWarned = true;
+      UnrealLogger::Log(projectairsim::LogLevel::kError,
+                        TEXT("[UnrealCamera] Fisheye composite has no UAV; "
+                             "the remap cannot run."));
+    }
+    return;
+  }
+
+  for (int32 i = 0; i < kFisheyeFaceCount && i < FisheyeFaceTargets.Num(); ++i) {
+    UTextureRenderTarget2D* FaceTarget = FisheyeFaceTargets[i];
+    if (FaceTarget == nullptr) return;
+    FTextureRenderTargetResource* FaceResource =
+        FaceTarget->GetRenderTargetResource();
+    if (FaceResource == nullptr) return;
+    Args.Faces[i].Texture = FaceResource->GetRenderTargetTexture();
+
+    // Derive each face's basis from the rotation actually applied to its
+    // component, so the shader never has to know Unreal's axis convention.
+    const FQuat FaceQuat = kFisheyeFaceRotations[i].Quaternion();
+    Args.Faces[i].Forward =
+        UnrealAxisToCameraFrame(FaceQuat.RotateVector(FVector::ForwardVector));
+    Args.Faces[i].Right =
+        UnrealAxisToCameraFrame(FaceQuat.RotateVector(FVector::RightVector));
+    Args.Faces[i].Down =
+        UnrealAxisToCameraFrame(-FaceQuat.RotateVector(FVector::UpVector));
+  }
+
+  DispatchFisheyeRemap(RHICmdList, Args);
+}
