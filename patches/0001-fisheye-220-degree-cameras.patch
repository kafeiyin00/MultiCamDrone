 #include "UnrealCompatibility.h"
 #include "UnrealHelpers.h"
@@ -334,9 +335,186 @@ void UUnrealCamera::SetupCameraFromSettings(
 
     Capture->TextureTarget = RenderTargets[ImageType];
   }
+
+  // Must come after the loop: it re-initialises the scene render target as the
+  // fisheye composite, which needs the target to already exist.
+  SetupFisheyeRig(CameraSetting.capture_settings.at(
+      projectairsim::MathUtils::ToNumeric(projectairsim::ImageType::kScene)));
